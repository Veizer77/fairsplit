{
  "rewrites": [
    {
      "source": "/api/bill/:id/pay",
      "destination": "/api/bill?id=:id"
    },
    {
      "source": "/api/bill/:id/:action*",
      "destination": "/api/bill?id=:id"
    },
    {
      "source": "/api/bill/:id",
      "destination": "/api/bill?id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
